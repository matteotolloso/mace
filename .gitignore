# --- Research layout (docs/layout.md) --------------------------------------------------
# Heavy, regenerable run artifacts: checkpoints, MACE logs, W&B, active-learning runs.
/runs/*
!/runs/README.md
# Large dataset files are ignored by data/.gitignore; *.xyz is ignored everywhere below.
# Overleaf-synchronized manuscript: an independent Git repository with its own remote.
/ICLR27-UQ-MF/
# results/: the ledger and curated tables/figures are tracked; MACE's default
# results_dir (./results) would otherwise dump training outputs here.
/results/*
!/results/results.md
!/results/tables/
!/results/figures/

# --- Python ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.benchmarks
.ipynb_checkpoints
.venv/
venv/

# --- Model and data files (upstream MACE defaults) ----------------------------------------
*.pt
*.model
*.models
*.xyz
*.db
*.log
*.txt
# ...but the curated result tables are text files
!/results/tables/*.txt

# --- Editors, OS, local tool settings -------------------------------------------------------
.idea/
.vscode/
.DS_Store
.claude/settings.local.json

# --- LaTeX build products (drafts compiled inside papers/) ----------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
